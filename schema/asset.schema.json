
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChibiDesk Asset",
  "description": "Schema for a verified wallpaper or desktop asset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "asset_type",
    "download_url",
    "categories",
    "submitted_by",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^asset_[a-zA-Z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "asset_type": {
      "type": "string",
      "enum": ["wallpaper", "asset"]
    },
    "download_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "preview_url": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      }
    },
    "format": {
      "type": ["string", "null"]
    },
    "file_size_bytes": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "resolution": {
      "type": ["string", "null"],
      "maxLength": 30
    },
    "submitted_by": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["pending", "approved", "rejected", "disabled"]
    },
    "verified_by": {
      "type": ["string", "null"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}

